# Copy this file to .env in the repository root (or windows/.env) and fill in your own keys.
# Provide ANY Vision/Chat API key (CUSTOM_API_KEY, OPENAI_API_KEY, ANTHROPIC_API_KEY, OPENROUTER_API_KEY, GROQ_API_KEY, DEEPSEEK_API_KEY, GOOGLE_API_KEY, RIVER_AI_API), plus ASSEMBLYAI_API_KEY for Voice.

# Universal / Custom OpenAI-compatible, Anthropic, Azure, OpenRouter, Groq, or Ollama configuration:
CUSTOM_API_KEY=
CUSTOM_API_BASE_URL=
CUSTOM_MODEL=

# Or use named provider keys directly (automatically routed to their provider endpoints):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
GOOGLE_API_KEY=your_google_gemini_api_key_here
RIVER_AI_API=your_river_ai_api_key_here

# Voice STT + TTS:
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
